# ==========================================================
# PROVENANCE-GUARDED RED-TEAM HARNESS - PERSON C (JUDGES)
# Environment Configuration
# ==========================================================

# Select LLM Provider: 'openai' | 'anthropic' | 'ollama' | 'mock'
JUDGE_LLM_PROVIDER=openai

# OpenAI API Configuration (default)
OPENAI_API_KEY=sk-your-openai-api-key-here
JUDGE_LLM_MODEL=gpt-4o-mini
JUDGE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# OR Anthropic API Configuration
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# JUDGE_LLM_MODEL=claude-3-5-haiku-20241022

# OR Ollama Local LLM Configuration (Zero API Key needed)
# OLLAMA_HOST=http://localhost:11434
# JUDGE_LLM_MODEL=qwen2.5:3b

# Set to 'true' to force offline mock evaluation mode for offline dry-runs
USE_MOCK_JUDGES=false
